local function setStatus(text)
    statusLabel.Text = "Status: " .. text
end

local function updateButton()
    if isRunning then
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
    else
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
        setStatus("Stopped")
        timerLabel.Text = "Next move: --:--"
    end
end

local function toggleMinimize()
    isMinimized = not isMinimized
    content.Visible = not isMinimized
    if isMinimized then
        mainFrame.Size = UDim2.new(0, 240, 0, 40)
        minimizeBtn.Text = "+"
    else
        mainFrame.Size = UDim2.new(0, 240, 0, 190)
        minimizeBtn.Text = "−"
    end
end

local function updateTimer()
    if not isRunning then return end
    local remaining = math.max(0, MOVE_INTERVAL - (os.clock() - lastMove))
    local mins = math.floor(remaining / 60)
    local secs = math.floor(remaining % 60)
    timerLabel.Text = string.format("Next move: %d:%02d", mins, secs)
end

-------------------------------------------------
-- Helpers
-------------------------------------------------
local function click()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local x = cam.ViewportSize.X / 2
    local y = cam.ViewportSize.Y / 2
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.04)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function isRodEquipped()
    local char = player.Character
    if not char then return false end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("rod") then
            return true
        end
    end
    return false
end

local function isNearSpot(index)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return (root.Position - spots[index]).Magnitude <= SPOT_TOLERANCE
end

local function faceLake()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local lookAt = Vector3.new(LAKE_CENTER.X, root.Position.Y, LAKE_CENTER.Z)
    root.CFrame = CFrame.lookAt(root.Position, lookAt)
    task.wait(0.2)
end

local function snapshot()
    known = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        known[v] = true
    end
end

local function findNewParts()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local parts = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if not known[v] and v:IsA("BasePart") and not v:IsDescendantOf(char) then
            local dist = (v.Position - root.Position).Magnitude
            if dist > 2 and dist < 35 then
                table.insert(parts, v)
            end
        end
    end
    return parts
end

local function pull()
    if not waitingForBite then return end
    waitingForBite = false
    click()
    tracked = {}
    setStatus("Caught!")
end

local function forceRecast()
    waitingForBite = false
    tracked = {}
    click()
    setStatus("Recasting...")
    task.wait(1)
end

local function pathfindTo(targetPos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, targetPos)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        humanoid:MoveTo(targetPos)
        task.wait(2)
        faceLake()
        return
    end

    for _, wp in ipairs(path:GetWaypoints()) do
        if not isRunning then break end
        humanoid:MoveTo(wp.Position)
        if wp.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end
        local finished = false
        local conn
        conn = humanoid.MoveToFinished:Connect(function()
            finished = true
            conn:Disconnect()
        end)
        local t = os.clock()
        while not finished and os.clock() - t < 4 do
            task.wait(0.1)
        end
        if conn then conn:Disconnect() end
    end

    faceLake()
end

local function goToSpot(index)
    setStatus("Going to spot " .. index .. "...")
    waitingForBite = false
    tracked = {}
    pathfindTo(spots[index])
    spotIndex = index
    lastMove = os.clock()
    task.wait(0.3)
end

-------------------------------------------------
-- Detection
-------------------------------------------------
local biteStart = 0
RunService.Heartbeat:Connect(function()
    if not isRunning or not waitingForBite then return end

    if os.clock() - biteStart > BITE_TIMEOUT then
        setStatus("Timeout...")
        forceRecast()
        return
    end

    local anyAlive = false
    for i = #tracked, 1, -1 do
        local e = tracked[i]
        if not e.part or not e.part.Parent then
            table.remove(tracked, i)
        else
            anyAlive = true
            local drop = e.startY - e.part.Position.Y
            if drop > DROP_THRESHOLD then
                pull()
                return
            end
        end
    end

    if not anyAlive then
        setStatus("Bobber gone...")
        forceRecast()
    end
end)

-------------------------------------------------
-- Main
-------------------------------------------------
task.spawn(function()
    while true do
        if isRunning then
            updateTimer()

            if not isNearSpot(spotIndex) then
                goToSpot(spotIndex)
            end

            if os.clock() - lastMove > MOVE_INTERVAL then
                local nextIndex = spotIndex % #spots + 1
                goToSpot(nextIndex)
            end

            if not isRodEquipped() then
                setStatus("Equip fishing rod!")
                waitingForBite = false
                tracked = {}
                task.wait(1)
            elseif not waitingForBite and os.clock() - lastCast >= CAST_COOLDOWN then
                -- Face the lake before every cast
                faceLake()
                setStatus("Casting...")
                snapshot()
                click()
                lastCast = os.clock()
                task.wait(2.5)

                local parts = findNewParts()
                if #parts > 0 then
                    tracked = {}
                    for _, p in ipairs(parts) do
                        table.insert(tracked, {part = p, startY = p.Position.Y})
                    end
                    biteStart = os.clock()
                    waitingForBite = true
                    setStatus("Waiting for bite...")
                else
                    setStatus("No bobber")
                    task.wait(0.6)
                end
            end
        else
            waitingForBite = false
            tracked = {}
        end
        task.wait(0.15)
    end
end)

