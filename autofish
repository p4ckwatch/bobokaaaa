        mainFrame.Size = UDim2.new(0, 240, 0, 40)
        minimizeBtn.Text = "+"
    else
        mainFrame.Size = UDim2.new(0, 240, 0, 210)
        minimizeBtn.Text = "−"
    end
end

local function updateTimer()
    if not isRunning then return end
    local remaining = math.max(0, MOVE_INTERVAL - (os.clock() - lastMove))
    local mins = math.floor(remaining / 60)
    local secs = math.floor(remaining % 60)
    timerLabel.Text = string.format("Next move: %d:%02d", mins, secs)
end

-------------------------------------------------
-- Fishing helpers
-------------------------------------------------
local function click()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local x = cam.ViewportSize.X / 2
    local y = cam.ViewportSize.Y / 2
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.25)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function isRodEquipped()
    local char = player.Character
    if not char then return false end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("rod") then return true end
    end
    return false
end

local function isNearSpot(index)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return (root.Position - spots[index]).Magnitude <= SPOT_TOLERANCE
end

local function snapshot()
    known = {}
    for _, v in ipairs(workspace:GetDescendants()) do known[v] = true end
end

local function findNewParts()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local parts = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if not known[v] and v:IsA("BasePart") and not v:IsDescendantOf(char) then
            local dist = (v.Position - root.Position).Magnitude
            if dist > 2 and dist < 35 then table.insert(parts, v) end
        end
    end
    return parts
end

local function pull()
    if not waitingForBite then return end
    waitingForBite = false
    click()
    tracked = {}
    setStatus("Caught!")
end

local function forceRecast()
    waitingForBite = false
    tracked = {}
    click()
    setStatus("Recasting...")
    task.wait(1)
end

local function pathfindTo(targetPos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
    local ok = pcall(function() path:ComputeAsync(root.Position, targetPos) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        humanoid:MoveTo(targetPos)
        task.wait(2)
        return
    end
    for _, wp in ipairs(path:GetWaypoints()) do
        if not isRunning then break end
        humanoid:MoveTo(wp.Position)
        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        local finished = false
        local conn
        conn = humanoid.MoveToFinished:Connect(function()
            finished = true
            conn:Disconnect()
        end)
        local t = os.clock()
        while not finished and os.clock() - t < 4 do task.wait(0.1) end
        if conn then conn:Disconnect() end
    end
end

local function goToSpot(index)
    setStatus("Going to spot " .. index .. "...")
    waitingForBite = false
    tracked = {}
    pathfindTo(spots[index])
    spotIndex = index
    lastMove = os.clock()
    task.wait(0.3)
end

-------------------------------------------------
-- Quiz detection
-------------------------------------------------
local function getQuizPanel()
    local fc = playerGui:FindFirstChild("FishingCheck")
    if not fc then return nil end
    local one = fc:FindFirstChild("1")
    if not one then return nil end
    local four = one:FindFirstChild("4")
    if not four then return nil end
    local two = four:FindFirstChild("2")
    if not two then return nil end
    return two:FindFirstChild("1")
end

local function getQuizTarget()
    local panel = getQuizPanel()
    if not panel then return nil, nil end
    local msg = panel:FindFirstChild("Message")
    if msg and msg:IsA("TextLabel") then
        local text = msg.Text:lower()
        local best
        for _, fish in ipairs(fishList) do
            local nf = fish:lower()
            if text:find(nf, 1, true) then
                if not best or #fish > #best then best = fish end
            end
        end
        if best then return best, panel end
    end
    return nil, panel
end

local function getChoiceList(panel)
    local list = {}
    if not panel then return list end
    for _, child in ipairs(panel:GetChildren()) do
        if child.Name == "Choice" and child:IsA("GuiButton") then
            local lbl = child:FindFirstChild("Label", true)
            table.insert(list, {btn = child, label = lbl and lbl.Text or ""})
        end
    end
    return list
end

local function fireRemoteDirect(index)
    local ok, err = pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then error("no Remotes folder") end
        local fc = remotes:FindFirstChild("FishingCheck")
        if not fc then error("no FishingCheck remote") end
        fc:FireServer(index)
    end)
    if not ok then print("[Quiz] FireServer failed:", err) end
    return ok
end

local function realClick(guiObj)
    local abs = guiObj.AbsolutePosition
    local size = guiObj.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    local x = abs.X + size.X / 2
    local y = abs.Y + size.Y / 2 + inset.Y
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function answerQuiz()
    local target, panel = getQuizTarget()
    if not target or not panel then return false end

    local choices = getChoiceList(panel)
    if #choices == 0 then
        setQuizStatus("waiting: " .. target)
        return false
    end

    local targetLower = target:lower()
    local correctIdx, correctChoice
    for i, c in ipairs(choices) do
        if c.label:lower() == targetLower then
            correctIdx = i
            correctChoice = c.btn
            break
        end
    end
    if not correctIdx then
        setQuizStatus("no match: " .. target)
        return false
    end

    if TRY_REMOTE_FIRST then
        fireRemoteDirect(correctIdx)
        task.wait(0.5)
        if not getQuizPanel() then
            setQuizStatus("answered: " .. target)
            return true
        end
    end

    if AUTO_ANSWER_QUIZ then
        realClick(correctChoice)
        task.wait(0.6)
        if not getQuizPanel() then
            setQuizStatus("answered: " .. target)
            return true
        end
    end

    return false
end

local quizBusy = false
task.spawn(function()
    while true do
        task.wait(0.2)
        if quizBusy then continue end
        if getQuizTarget() then
            quizBusy = true
            local t0 = os.clock()
            while os.clock() - t0 < 8 do
                if answerQuiz() then break end
                task.wait(0.4)
            end
            quizBusy = false
        end
    end
end)

-------------------------------------------------
-- Bite detection
-------------------------------------------------
local biteStart = 0
RunService.Heartbeat:Connect(function()
    if not isRunning or not waitingForBite then return end
    if os.clock() - biteStart > BITE_TIMEOUT then
        setStatus("Timeout...")
        forceRecast()
        return
    end
    local anyAlive = false
    for i = #tracked, 1, -1 do
        local e = tracked[i]
        if not e.part or not e.part.Parent then
            table.remove(tracked, i)
        else
            anyAlive = true
            local drop = e.startY - e.part.Position.Y
            if drop > DROP_THRESHOLD then pull() return end
        end
    end
    if not anyAlive then
        setStatus("Bobber gone...")
        forceRecast()
    end
end)

-------------------------------------------------
-- Main fishing loop
-------------------------------------------------
local extracted = function()
    while true do
        if isRunning then
            updateTimer()
            if not isNearSpot(spotIndex) then goToSpot(spotIndex) end
            if os.clock() - lastMove > MOVE_INTERVAL then
                local nextIndex = spotIndex % #spots + 1
                goToSpot(nextIndex)
            end
            if not isRodEquipped() then
                setStatus("Equip fishing rod!")
                waitingForBite = false
                tracked = {}
                task.wait(1)
            elseif not waitingForBite and os.clock() - lastCast >= CAST_COOLDOWN then
                setStatus("Casting...")
                snapshot()
                click()
                lastCast = os.clock()
                task.wait(1)
                local parts = findNewParts()
                if #parts > 0 then
                    tracked = {}
                    for _, p in ipairs(parts) do
                        table.insert(tracked, {part = p, startY = p.Position.Y})
                    end
                    biteStart = os.clock()
                    waitingForBite = true
                    setStatus("Waiting for bite...")
                else
                    setStatus("No bobber")
                    task.wait(0.6)
                end
            end
        else
            waitingForBite = false
            tracked = {}
        end
        task.wait(0.15)
    end
end
task.spawn(extracted)

