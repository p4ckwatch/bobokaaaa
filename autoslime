-- Config
local PRIORITY = {
    ["Orange"] = 1,
    ["Pink"] = 2,
    ["Purple"] = 3,
    ["Blue"] = 4,
    ["Green"] = 5,
}
local ABOVE_DISTANCE = 6
local ATTACK_INTERVAL = 0.1
local MIN_Y = 180
local MOVE_SPEED = 40

-- Decoy positions to avoid
local DECOY_POSITIONS = {
    Vector3.new(24, 197, -112),
    Vector3.new(8, 201, -80),
}
local DECOY_RADIUS = 25

