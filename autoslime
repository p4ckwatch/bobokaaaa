-- Draggable
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)
header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ========== MAIN LOOP ==========
local renderConn = RunService.Heartbeat:Connect(function()
    if not isRunning then return end

    if startTime > 0 then
        runtimeLabel.Text = "Runtime: " .. formatTime(tick() - startTime)
    end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not velocity then
        createVelocity(hrp)
    end

    -- Only scan when we need a new target
    if not isTargetAlive(currentTarget) then
        local best = findBestSlime()
        if best then
            currentTarget = best
            setStatus("Above " .. best.color)
            targetLabel.Text = "Target: " .. best.color .. " Slime"
        else
            currentTarget = nil
            setStatus("Searching...")
            targetLabel.Text = "Target: None"
            if velocity then velocity.VectorVelocity = Vector3.zero end
            return
        end
    end

    if isTargetAlive(currentTarget) and velocity then
        local targetPos = currentTarget.root.Position + Vector3.new(0, ABOVE_DISTANCE, 0)
        local direction = (targetPos - hrp.Position)
        local dist = direction.Magnitude

        if dist > 1.5 then
            velocity.VectorVelocity = direction.Unit * math.min(MOVE_SPEED, dist * 4)
        else
            velocity.VectorVelocity = Vector3.zero
        end

        if tick() - lastClick >= ATTACK_INTERVAL then
            lastClick = tick()
            click()
        end
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    updateButton()

    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if isRunning then
        startTime = tick()
        enableNoclip()
        setStatus("Starting...")
        if hrp then createVelocity(hrp) end
        local green = getGreenSlime()
        if green then
            currentTarget = green
            setStatus("Above Green")
            targetLabel.Text = "Target: Green Slime"
        else
            setStatus("No valid Green found")
        end
    else
        currentTarget = nil
        removeVelocity()
        disableNoclip()
        startTime = 0
        setStatus("Stopped")
        targetLabel.Text = "Target: None"
    end
end)

minimizeBtn.MouseButton1Click:Connect(toggleMinimize)

-- Cleanup
_G.SlimeOrbitCleanup = function()
    pcall(function()
        if renderConn then renderConn:Disconnect() end
        if screenGui then screenGui:Destroy() end
        removeVelocity()
        disableNoclip()
    end)
    isRunning = false
    currentTarget = nil
end

