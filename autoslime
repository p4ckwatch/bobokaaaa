-- ========== FUNCTIONS ==========
local function getSlimeColor(model)
    local outside = model:FindFirstChild("Outside")
    if not outside or not outside:IsA("BasePart") then return "Unknown" end
    local c = outside.Color
    local r, g, b = c.R, c.G, c.B
    if g > 0.5 and g > r and g > b then return "Green"
    elseif b > 0.4 and b > r and b > g then return "Blue"
    elseif r > 0.7 and b > 0.5 and g > 0.3 and g < 0.7 then return "Pink"
    elseif r > 0.4 and b > 0.4 and g < 0.4 then return "Purple"
    elseif r > 0.5 and g > 0.3 and b < 0.3 then return "Orange"
    end
    return "Unknown"
end

local function isDecoy(position)
    if position.Y < MIN_Y then return true end
    for _, decoyPos in ipairs(DECOY_POSITIONS) do
        if (position - decoyPos).Magnitude <= DECOY_RADIUS then
            return true
        end
    end
    return false
end

local function findBestSlime()
    local best, bestPriority = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("slime") then
            local root = obj.PrimaryPart
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("HB")
                or obj:FindFirstChildWhichIsA("BasePart")
            if root and root:IsA("BasePart") and not isDecoy(root.Position) then
                local color = getSlimeColor(obj)
                local priority = PRIORITY[color]
                if priority and priority < bestPriority then
                    bestPriority = priority
                    best = {
                        model = obj,
                        root = root,
                        color = color,
                        priority = priority
                    }
                end
            end
        end
    end
    return best
end

local function getGreenSlime()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("slime") then
            local root = obj.PrimaryPart
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("HB")
                or obj:FindFirstChildWhichIsA("BasePart")
            if root and root:IsA("BasePart") and not isDecoy(root.Position) then
                local color = getSlimeColor(obj)
                if color == "Green" then
                    return {
                        model = obj,
                        root = root,
                        color = color,
                        priority = PRIORITY[color]
                    }
                end
            end
        end
    end
    return nil
end

local function isTargetAlive(target)
    return target and target.root and target.root.Parent and target.model and target.model.Parent
end

local function click()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local x, y = camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function createVelocity(hrp)
    if velocity then velocity:Destroy() end
    velocity = Instance.new("LinearVelocity")
    velocity.MaxForce = math.huge
    velocity.VectorVelocity = Vector3.zero
    velocity.Attachment0 = hrp.RootAttachment or hrp:FindFirstChildOfClass("Attachment")
    if not velocity.Attachment0 then
        local att = Instance.new("Attachment")
        att.Parent = hrp
        velocity.Attachment0 = att
    end
    velocity.Parent = hrp
end

local function removeVelocity()
    if velocity then
        velocity:Destroy()
        velocity = nil
    end
end

local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = player.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

